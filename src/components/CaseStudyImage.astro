---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  slug: string;
  name: string;
  alt?: string;
}

const { slug, name, alt = "" } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/case-study-*/*.{jpg,jpeg,png,webp,gif,svg}",
  { eager: true },
);

const match = Object.entries(imageModules).find(([path]) => {
  const fileName = path.split("/").pop()?.replace(/\.[^.]+$/, "");
  return path.includes(`/${slug}/`) && fileName === name;
});
---

{match ? (
  <Image class="case-study-image" src={match[1].default} alt={alt} format="webp" quality={80} />
) : (
  <div class="case-study-image case-study-image--placeholder" role="img" aria-label={alt || `${name} placeholder`}>
    <span>Add {name}.png to src/assets/images/{slug}/</span>
  </div>
)}

<style>
  .case-study-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .case-study-image--placeholder {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    text-align: center;
    background: var(--color-grey950);
    border: 1px solid var(--color-border);
  }

  .case-study-image--placeholder span {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-grey700);
  }
</style>
