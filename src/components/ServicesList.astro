---
import Icon from "./Icon.astro";

interface Service {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<ul class="services-list">
  {services.map((service) => (
    <li class="services-list__row">
      <h3 class="services-list__title">{service.title}</h3>
      <p class="services-list__description">{service.description}</p>
      <Icon name={service.icon} size={32} />
    </li>
  ))}
</ul>

<style>
  .services-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-list__row {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .services-list__row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .services-list__title {
    font-family: var(--font-inter);
    font-weight: var(--text-body-bold-weight);
    font-size: var(--text-body-regular-size);
    color: var(--color-fg);
  }

  .services-list__description {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .services-list__row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "title icon"
        "desc desc";
    }

    .services-list__title {
      grid-area: title;
    }

    .services-list__description {
      grid-area: desc;
    }
  }
</style>
