---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  slug: string;
  title: string;
  year: string;
  tags: string[];
  description: string;
  image?: string;
}

const { href, slug, title, year, tags, description, image } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/case-study-*/*.{jpg,jpeg,png,webp,gif,svg}",
  { eager: true },
);

const slugImages = Object.entries(imageModules)
  .filter(([path]) => path.includes(`/${slug}/`))
  .sort(([a], [b]) => a.localeCompare(b));

const [, firstImage] =
  (image
    ? slugImages.find(([path]) => {
        const fileName = path.split("/").pop()?.replace(/\.[^.]+$/, "");
        return fileName === image;
      })
    : slugImages[0]) ?? [];
---

<article class="case-study-card">
  <div class="case-study-card__header">
    <div class="case-study-card__info">
      <h3 class="case-study-card__title">{title}</h3>
      <p class="case-study-card__meta">{year} | {tags.join(", ")}</p>
      <a class="case-study-card__cta" href={href}>
        Learn more <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <p class="case-study-card__description">{description}</p>
  </div>

  {firstImage ? (
    <Image class="case-study-card__image" src={firstImage.default} alt="" format="webp" quality={80} />
  ) : (
    <div class="case-study-card__image case-study-card__image--placeholder" role="img" aria-label={`${title} preview placeholder`}>
      <span>Add an image to src/assets/images/{slug}/</span>
    </div>
  )}
</article>

<style>
  .case-study-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study-card__header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .case-study-card__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .case-study-card__title {
    font-family: var(--text-h2-font);
    font-weight: var(--text-h2-weight);
    font-size: var(--text-h2-size);
    letter-spacing: var(--text-h2-letter-spacing);
    color: var(--color-fg);
  }

  .case-study-card__meta {
    font-family: var(--text-body-regular-font);
    font-weight: var(--text-body-regular-weight);
    font-size: var(--text-body-regular-size);
    letter-spacing: var(--text-body-regular-letter-spacing);
    color: var(--color-muted);
  }

  .case-study-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--color-fg);
    color: var(--color-white);
    font-family: var(--text-body-bold-font);
    font-weight: var(--text-body-bold-weight);
    font-size: var(--text-body-bold-size);
    text-decoration: none;
  }

  .case-study-card__cta:hover {
    background: var(--color-grey200);
  }

  .case-study-card__description {
    font-family: var(--font-inter);
    font-size: var(--text-body-regular-size);
    color: var(--color-fg);
    margin-top: var(--space-1);
  }

  .case-study-card__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    background: var(--color-grey950);
    border: 1px solid var(--color-border);
  }

  .case-study-card__image--placeholder {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    text-align: center;
  }

  .case-study-card__image--placeholder span {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-grey700);
  }

  @media (max-width: 48rem) {
    .case-study-card__header {
      grid-template-columns: 1fr;
    }
  }
</style>
