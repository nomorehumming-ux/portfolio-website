---
const year = new Date().getFullYear();
const email = "no.more.humming@gmail.com";

const socials = [
  { href: "https://www.behance.net/", label: "Behance" },
  { href: "https://dribbble.com/", label: "Dribble" },
  { href: "https://bsky.app/", label: "Bluesky" },
];
---

<section class="contact" id="contact">
  <h2 class="contact__heading">Get in touch</h2>
  <a class="contact__email" href={`mailto:${email}`}>{email}</a>
</section>

<div class="back-to-top-wrap">
  <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">&uarr;</span></a>
</div>

<footer class="footer">
  <p class="footer__copy">&copy; {year} Bartek Dzięgiel.</p>
  <ul class="footer__socials">
    {socials.map((social) => (
      <li><a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a></li>
    ))}
  </ul>
</footer>

<style>
  .contact {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-6) var(--space-3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .contact__heading {
    font-family: var(--text-section-heading-font);
    font-weight: var(--text-section-heading-weight);
    font-size: var(--text-section-heading-size);
    letter-spacing: var(--text-section-heading-letter-spacing);
    line-height: var(--text-section-heading-line-height);
    color: var(--color-fg);
  }

  .contact__email {
    font-family: var(--font-inter);
    font-size: var(--text-body-regular-size);
    color: var(--color-fg);
    text-decoration: none;
  }

  .contact__email:hover {
    color: var(--color-muted);
  }

  .back-to-top-wrap {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-3);
    text-align: right;
  }

  .back-to-top {
    font-family: var(--text-body-regular-font);
    font-weight: var(--text-body-regular-weight);
    font-size: var(--text-body-regular-size);
    letter-spacing: var(--text-body-regular-letter-spacing);
    line-height: var(--text-body-regular-line-height);
    color: var(--color-fg);
    text-decoration: none;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-5);
    max-width: var(--content-max-width);
    margin-inline: auto;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-3);
  }

  .footer__copy {
    color: var(--color-muted);
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__socials a {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer__socials a:hover {
    color: var(--color-fg);
  }

  @media (max-width: 48rem) {
    .footer {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-3);
      padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
