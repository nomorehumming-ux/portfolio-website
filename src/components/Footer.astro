---
const year = new Date().getFullYear();

const socials = [
  { href: "https://www.behance.net/", label: "Behance" },
  { href: "https://dribbble.com/", label: "Dribble" },
  { href: "https://bsky.app/", label: "Bluesky" },
];
---

<div class="back-to-top-wrap">
  <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">&uarr;</span></a>
</div>

<footer class="footer" id="contact">
  <p class="footer__copy">&copy; {year} Bartek Dzięgiel.</p>
  <ul class="footer__socials">
    {socials.map((social) => (
      <li><a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a></li>
    ))}
  </ul>
</footer>

<style>
  .back-to-top-wrap {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-3);
    text-align: right;
  }

  .back-to-top {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-fg);
    text-decoration: none;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-5);
    max-width: var(--content-max-width);
    margin-inline: auto;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-3);
  }

  .footer__copy {
    color: var(--color-muted);
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__socials a {
    font-family: var(--font-inter);
    font-size: var(--text-body-small-regular-size);
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer__socials a:hover {
    color: var(--color-fg);
  }
</style>
