---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 24 } = Astro.props;
const icons = import.meta.glob("../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const match = Object.entries(icons).find(([path]) =>
  path.endsWith(`/${name}.svg`),
);
const svg = match?.[1];
---

{svg ? (
  <span class="icon" style={`--icon-size: ${size}px`} set:html={svg} />
) : (
  <span class="icon icon--missing" style={`--icon-size: ${size}px`} title={`Missing icon: ${name}`} />
)}

<style>
  .icon {
    display: inline-block;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .icon--missing {
    background: var(--color-border);
    border-radius: 2px;
  }
</style>
