---
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: "Work" },
  { href: `${base}illustrations`, label: "Illustrations" },
];
---

<nav class="nav">
  <a class="nav__logo" href={base}>Portfolio</a>
  <ul class="nav__links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3);
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .nav__logo {
    font-weight: 600;
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    text-decoration: none;
  }
</style>
