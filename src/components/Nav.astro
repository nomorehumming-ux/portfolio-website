---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const links = [
  { href: base, label: "Home" },
  { href: `${base}#work`, label: "Work" },
  { href: `${base}#contact`, label: "About+Contact" },
];

const socials = [
  { href: "https://www.behance.net/", label: "Behance" },
  { href: "https://dribbble.com/", label: "Dribble" },
  { href: "https://bsky.app/", label: "Bluesky" },
];
---

<nav class="nav" id="site-nav">
  <div class="nav__bar">
    <a class="nav__logo" href={base} aria-label="Home">
      <Icon name="logo" size={40} />
    </a>

    <ul class="nav__links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <button
      class="nav__toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle menu"
    >
      <span class="nav__toggle-icon nav__toggle-icon--menu">
        <Icon name="menu" size={40} />
      </span>
      <span class="nav__toggle-icon nav__toggle-icon--close">
        <Icon name="x" size={40} />
      </span>
    </button>
  </div>

  <div class="nav__menu" id="nav-menu">
    <ul class="nav__menu-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <div class="nav__menu-footer">
      <ul class="nav__menu-socials">
        {socials.map((social) => (
          <li><a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a></li>
        ))}
      </ul>
      <p class="nav__menu-copy">&copy; {year} Bartek Dzięgiel.</p>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");

  function closeMenu() {
    nav?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  function openMenu() {
    nav?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  toggle?.addEventListener("click", () => {
    if (nav?.classList.contains("is-open")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  nav?.querySelectorAll(".nav__menu a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-4) var(--space-3);
  }

  .nav__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .nav__logo {
    display: block;
    line-height: 0;
    padding: var(--space-2);
    border-radius: 16px;
    background: var(--color-nav-pill);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    will-change: backdrop-filter;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: 16px;
    background: var(--color-nav-pill);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    will-change: backdrop-filter;
  }

  .nav__links a {
    font-family: var(--font-inter);
    font-size: var(--text-body-regular-size);
    color: var(--color-fg);
    text-decoration: none;
  }

  .nav__links a:hover {
    color: var(--color-muted);
  }

  .nav__toggle {
    display: none;
  }

  .nav__menu {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .nav__bar {
      background: var(--color-white);
      border-radius: 16px;
      padding: var(--space-2);
    }

    .nav__logo {
      padding: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
      color: var(--color-fg);
    }

    .nav__toggle-icon {
      display: flex;
    }

    .nav__toggle-icon--close {
      display: none;
    }

    .nav.is-open .nav__toggle-icon--menu {
      display: none;
    }

    .nav.is-open .nav__toggle-icon--close {
      display: flex;
    }

    .nav__menu {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      justify-content: space-between;
      background: var(--color-white);
      padding: calc(var(--space-4) + 56px + var(--space-5)) var(--space-4) var(--space-5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .nav.is-open .nav__menu {
      opacity: 1;
      pointer-events: auto;
    }

    .nav__menu-links {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav__menu-links a {
      font-family: var(--text-h2-font);
      font-weight: var(--text-h2-weight);
      font-size: var(--text-h2-size);
      color: var(--color-fg);
      text-decoration: none;
    }

    .nav__menu-footer {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .nav__menu-socials {
      display: flex;
      gap: var(--space-4);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav__menu-socials a {
      font-family: var(--font-inter);
      font-size: var(--text-body-small-regular-size);
      color: var(--color-muted);
      text-decoration: underline;
    }

    .nav__menu-copy {
      font-family: var(--font-inter);
      font-size: var(--text-body-small-regular-size);
      color: var(--color-muted);
    }
  }
</style>
