---
import { projects } from "../data/projects";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const byYearDesc = [...projects].sort((a, b) => Number(b.year) - Number(a.year));
const index = byYearDesc.findIndex((project) => project.slug === slug);
const prev = byYearDesc[(index - 1 + byYearDesc.length) % byYearDesc.length];
const next = byYearDesc[(index + 1) % byYearDesc.length];
---

<nav class="project-nav" aria-label="Other projects">
  <h2 class="project-nav__heading">See other projects</h2>
  <div class="project-nav__links">
    <a class="project-nav__link project-nav__link--prev" href={`${base}/work/${prev.slug}`}>
      <span aria-hidden="true">&larr;</span> Previous project
    </a>
    <a class="project-nav__link project-nav__link--next" href={`${base}/work/${next.slug}`}>
      Next project <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</nav>

<style>
  .project-nav {
    max-width: var(--content-max-width);
    margin-inline: auto;
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-nav__heading {
    font-family: var(--text-body-large-font);
    font-weight: var(--text-body-large-weight);
    font-size: var(--text-body-large-size);
    letter-spacing: var(--text-body-large-letter-spacing);
    line-height: var(--text-body-large-line-height);
    color: var(--color-fg);
  }

  .project-nav__links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-nav__link {
    font-family: var(--text-body-regular-font);
    font-size: var(--text-body-regular-size);
    color: var(--color-fg);
    text-decoration: none;
  }

  .project-nav__link:hover {
    color: var(--color-muted);
  }
</style>
