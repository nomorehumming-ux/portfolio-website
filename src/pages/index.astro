---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const caseStudies = [
  { slug: "case-study-1", title: "Case Study 1" },
  { slug: "case-study-2", title: "Case Study 2" },
  { slug: "case-study-3", title: "Case Study 3" },
];
---

<BaseLayout title="Portfolio" description="Selected work">
  <section class="work">
    <h1>Selected work</h1>
    <ul class="work__list">
      {caseStudies.map((study) => (
        <li>
          <a href={`${base}work/${study.slug}`}>{study.title}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .work {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-5) var(--space-3);
  }

  .work__list {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }
</style>
