---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MediaTicker from "../components/MediaTicker.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ServicesList from "../components/ServicesList.astro";

const base = import.meta.env.BASE_URL;

const caseStudies = [
  {
    slug: "march-for-science",
    title: "March for Science",
    year: "2024",
    tags: ["Product design", "UI/UX", "User research"],
    description:
      "This project involved redesign of the 'March for Science Foundation' website, a non-profit organization dedicated to promoting science. Our work was a volunteer effort as part of the larger 'Strona od Nowa' initiative.",
    image: "marchForScience",
  },
  {
    slug: "talebook-autotag",
    title: "Talebook Autotag",
    year: "2023",
    tags: ["Product design", "UI/UX", "User research"],
    description:
      "Autotag is a feature for Talebook, an interactive research repository platform. It automatically attributes tags to the pieces of data researchers collected during the user research study.",
    image: "talebookAutotag",
  },
  {
    slug: "comm-bud",
    title: "Comm-Bud",
    year: "2023",
    tags: ["Product design", "UI/UX", "User research"],
    description:
      "Comm-Bud app makes finding a contractor for a construction project easier. This product was designed during a hackathon Build the Beaty, organized by L'Oreal, Saint-Gobain, and Generator Pomysłów. The app received a 3rd award in the hackathon contest.",
    image: "commBud",
  },
];

const services = [
  {
    title: "User research",
    description:
      "From heuristic evaluation, through stakeholder interviews and usability testing to competitive analysis. My design choices are consistently guided by insights gained through research.",
    icon: "research",
  },
  {
    title: "Product design",
    description:
      "As a UX designer, I specialize in product design. I excel in crafting intuitive user flows through constructing precise wireframes, mockups and prototypes.",
    icon: "product-design",
  },
  {
    title: "Branding & visual identity",
    description:
      "I craft bespoke visual identities that clearly communicate a brand's mission and values, from logo systems to full brand guidelines.",
    icon: "branding",
  },
  {
    title: "Illustration & iconography",
    description:
      "I design custom icons, symbols, pictograms, and characters that illustrate complex ideas and give products a distinct, memorable personality, from onboarding flows to empty states.",
    icon: "illustration",
  },
  {
    title: "Motion design",
    description:
      "Breathing life into interfaces through purposeful animation. I use movement to elevate the user experience and showcase your brand in action.",
    icon: "motion",
  },
];
---

<BaseLayout title="Bartek Dzięgiel — Portfolio" description="Warsaw based designer working across illustration, motion design and interfaces.">
  <Hero
    name="I'm Bartek Dzięgiel,"
    description="UX/Visual Designer working across product, illustration, and motion design."
  />

  <MediaTicker />

  <section class="selected-work" id="work">
    <h2 class="section-heading">Selected work</h2>
    <div class="selected-work__list">
      {caseStudies.map((study) => (
        <CaseStudyCard
          href={`${base}/work/${study.slug}`}
          slug={study.slug}
          title={study.title}
          year={study.year}
          tags={study.tags}
          description={study.description}
          image={study.image}
        />
      ))}
    </div>
    <div class="selected-work__all-wrap">
      <a class="selected-work__all-link" href={`${base}/work`}>All work <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <section class="services">
    <h2 class="section-heading">Services</h2>
    <ServicesList services={services} />
  </section>
</BaseLayout>

<style>
  .selected-work,
  .services {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-6) var(--space-3);
  }

  .selected-work {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    font-family: var(--text-section-heading-font);
    font-weight: var(--text-section-heading-weight);
    font-size: var(--text-section-heading-size);
    letter-spacing: var(--text-section-heading-letter-spacing);
    line-height: var(--text-section-heading-line-height);
    color: var(--color-fg);
  }

  .selected-work__list {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .selected-work__all-wrap {
    margin-top: var(--space-5);
    text-align: right;
  }

  .selected-work__all-link {
    font-family: var(--text-body-regular-font);
    font-weight: var(--text-body-regular-weight);
    font-size: var(--text-body-regular-size);
    letter-spacing: var(--text-body-regular-letter-spacing);
    line-height: var(--text-body-regular-line-height);
    color: var(--color-fg);
    text-decoration: none;
  }

  .selected-work__all-link:hover {
    color: var(--color-muted);
  }

  .services .services-list {
    margin-top: var(--space-4);
  }
</style>
