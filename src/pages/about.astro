---
import BaseLayout from "../layouts/BaseLayout.astro";

const columns = [
  [
    "Drawing from my background in art conservation and illustration, I bring a high level of craft and polish to every project.",
    "I work primarily in Figma, Framer, and Illustrator, to craft accessible and intuitive digital experiences.",
  ],
  [
    "I thrive on mission-driven projects and am always looking to connect with teams building innovative products",
    "When I'm not pushing pixels, you can find my personal artwork under the pseudonym No More Humming.",
  ],
];
---

<BaseLayout
  title="About+Contact — Bartek Dzięgiel"
  description="UX/Visual designer with a background in art conservation and illustration, building intuitive and accessible digital spaces."
>
  <section class="about-hero">
    <h1 class="about-hero__title">
      Hi, I'm Bartek Dzięgiel, a UX/Visual Designer who builds intuitive and accessible digital spaces.
    </h1>
  </section>

  <section class="about-info">
    {columns.map((paragraphs) => (
      <div class="about-info__column">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .about-hero {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: 120px var(--space-3) var(--space-5);
  }

  .about-hero__title {
    font-family: var(--text-display-font);
    font-weight: var(--text-display-weight);
    font-size: var(--text-display-size);
    letter-spacing: var(--text-display-letter-spacing);
    line-height: var(--text-display-line-height);
    color: var(--color-fg);
  }

  .about-info {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-5) var(--space-3);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .about-info__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-info__column p {
    font-family: var(--text-body-regular-font);
    font-weight: var(--text-body-regular-weight);
    font-size: var(--text-body-regular-size);
    letter-spacing: var(--text-body-regular-letter-spacing);
    line-height: var(--text-body-regular-line-height);
    color: var(--color-fg);
  }

  @media (max-width: 48rem) {
    .about-hero__title {
      font-size: 2.5rem;
    }

    .about-info {
      grid-template-columns: 1fr;
    }
  }
</style>
